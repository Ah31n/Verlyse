# Verlyse Media — InfinityFree (Apache/LiteSpeed) static hosting rules.
# Every real route ships a prerendered directory-index shell; the rewrite
# below is the safety net for client-side routes and query states so a hard
# refresh / deep link never hits the host's default 404 page.

DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Existing files and directories (including prerendered shells) pass through.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else is answered by the application shell (it renders NotFound).
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>

# Hashed build assets are immutable; HTML shells must always revalidate.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

Options -Indexes
