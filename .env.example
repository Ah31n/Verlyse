# Verlyse Media — Server-only Environment Variables (Vercel Serverless Functions)
# Never prefix these with VITE_ or commit actual secrets to Git.

# 1. Newsletter subscription endpoint (/api/newsletter -> Buttondown)
BUTTONDOWN_API_KEY=

# 2. Editorial submission & correspondence endpoint (/api/submit)
# Choose your mail provider ("resend" or "webhook"; auto-detected if omitted):
VERLYSE_MAIL_PROVIDER=

# Option A: Resend transactional email API (recommended for binary attachments)
RESEND_API_KEY=
VERLYSE_SUBMISSION_FROM_EMAIL=Verlyse Editorial Desk <submissions@yourdomain.example>
VERLYSE_SUBMISSION_TO_EMAIL=Verlysemedia.09@gmail.com

# Option B: Custom HTTPS mail relay / provider webhook
VERLYSE_MAIL_WEBHOOK_URL=
VERLYSE_MAIL_WEBHOOK_SECRET=

# Optional comma-separated cross-origin allowlist override (defaults to
# Kesug-only https://verlysemedia.kesug.com,https://www.verlysemedia.kesug.com in production)
ALLOWED_ORIGINS=https://verlysemedia.kesug.com,https://www.verlysemedia.kesug.com
