    "test:interaction": "node scripts/interaction-audit.mjs",
    "test:audit": "node scripts/full-matrix-audit.mjs",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:metadata": "node scripts/metadata-audit.mjs",
    "test:newsletter": "node scripts/newsletter-smoke.mjs",
    "test:smoke": "node scripts/ssr-smoke.mjs",
    "test:crawl": "node scripts/route-crawl-53.mjs",
    "test:mobile-perf": "node scripts/mobile-perf-audit.mjs",
    "asset-audit": "node scripts/asset-audit.mjs"
  },
  "dependencies": {
    "@fiddle-digital/string-tune": "^1.2.5",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/fiber": "^8.18.0",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer": "^24.43.1",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
