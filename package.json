{
  "name": "verlyse-media",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Verlyse Media — Where Vision Becomes A Voice. React + Tailwind + TypeScript editorial publication.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-metadata.mjs",
    "preview": "vite preview",
